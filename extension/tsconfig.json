{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@aturi/*": ["../src/utils/*"]
    },
    "types": ["chrome", "vitest/globals"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/utils/**/*",
    ".wxt/wxt.d.ts",
    ".wxt/types/**/*.d.ts"
  ]
}
