# aturi.to Configuration
# Copy this file to .env.local and customize for your fork

# Your custom domain (required when forking)
NEXT_PUBLIC_DOMAIN=aturi.to

# Full site URL (auto-detected on Vercel, but you can override)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Site branding
NEXT_PUBLIC_SITE_NAME=aturi.to
NEXT_PUBLIC_SITE_DESCRIPTION=Fast travel across the Atmosphere

# Author/Creator info (update if forking)
NEXT_PUBLIC_AUTHOR_NAME=dame
NEXT_PUBLIC_AUTHOR_URL=https://atpota.to

# Source code repository URL
NEXT_PUBLIC_REPO_URL=https://tangled.org/atpota.to/aturi

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ============================================================================
# BACKEND (CONFIDENTIAL-CLIENT) OAUTH — optional, for long-lived sessions
# ============================================================================
# When enabled, OAuth runs through a confidential client on /api/oauth/* (tokens
# held + refreshed server-side, browser keeps only a 30-day opaque token) instead
# of the in-browser public client. Leave the flag off to use browser OAuth.
#
# The confidential flow CANNOT be tested on localhost: the Authorization Server
# must fetch the client metadata + JWKS over the public internet to verify the
# private_key_jwt assertion. Test on a public origin (Vercel preview / tunnel)
# with OAUTH_BASE_URL set to that exact origin.

# Feature flag — set to "true" to use the backend OAuth flow.
# NEXT_PUBLIC_USE_BACKEND_OAUTH=false

# Canonical origin the confidential client_id / redirect_uri / jwks_uri are built
# from. Must match the public origin the app is served on.
# OAUTH_BASE_URL=https://aturi.to

# Supabase (atpota.to project) — SERVER ONLY, never expose with NEXT_PUBLIC_.
# Tables: aturi_oauth_sessions / aturi_oauth_state / aturi_frontend_sessions.
# SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# Confidential client signing key(s) — ES256 JWK JSON, one per line. Generate
# with: node scripts/generate-oauth-key.mjs  (1 required; _2/_3 for rotation).
# SERVER ONLY — never expose with NEXT_PUBLIC_.
# OAUTH_PRIVATE_KEY_1={"kty":"EC","crv":"P-256","alg":"ES256","use":"sig","kid":"key1",...}
# OAUTH_PRIVATE_KEY_2=
# OAUTH_PRIVATE_KEY_3=
