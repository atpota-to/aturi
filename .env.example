# aturi.to Configuration
# Copy this file to .env.local and customize for your fork

# Your custom domain (required when forking)
NEXT_PUBLIC_DOMAIN=aturi.to

# Full site URL (auto-detected on Vercel, but you can override)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Site branding
NEXT_PUBLIC_SITE_NAME=aturi.to
NEXT_PUBLIC_SITE_DESCRIPTION=Fast travel across the Atmosphere

# Author/Creator info (update if forking)
NEXT_PUBLIC_AUTHOR_NAME=dame
NEXT_PUBLIC_AUTHOR_URL=https://atpota.to

# Source code repository URL
NEXT_PUBLIC_REPO_URL=https://tangled.org/atpota.to/aturi

# Feedback board (/feedback)
#
# The board renders an app.userinput.space record. Point it at the account that
# owns yours; the board scans that repo and uses the earliest space it finds, so
# a fork only needs to change this line (and can create the space from the page
# itself once signed in as that account).
# NEXT_PUBLIC_FEEDBACK_OWNER=aturi.to
#
# Optional: pin an exact space instead of discovering one. Skips the repo scan,
# and keeps the board on one space if the owner later creates more.
# NEXT_PUBLIC_FEEDBACK_SPACE_URI=at://did:plc:.../app.userinput.space/3l...

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ---------------------------------------------------------------------------
# Backend OAuth (optional)
#
# Leave every variable below unset and the app uses the public browser OAuth
# client it always has. A fork does not need a database, and `git clone &&
# vercel` still signs in.
#
# Setting them enables a confidential OAuth client whose tokens never reach the
# browser. The only user-visible difference is session length: the spec caps a
# public client at roughly two weeks, while a confidential client's session may
# be unlimited. See docs/backend-oauth.md, and apply sql/001_oauth_bff.sql.
#
# All of these are SERVER-side. None may be given a NEXT_PUBLIC_ prefix — that
# would inline the value into the browser bundle. `npm run lint` fails if one
# is.
# ---------------------------------------------------------------------------

# ES256 signing key, from `node scripts/generate-oauth-key.mjs`.
# In Vercel, scope this to Production ONLY. The dashboard default is
# Production + Preview + Development, which puts the private key in every
# pull-request preview.
# ATURI_OAUTH_JWK_ACTIVE=

# Published but never used to sign — set only while rotating, then clear.
# ATURI_OAUTH_JWK_RETIRED=

# Storage. Only the "postgrest" driver ships (Supabase and anything else
# speaking PostgREST); it takes no client library.
# ATURI_DB_DRIVER=postgrest
# ATURI_DB_URL=https://<project>.supabase.co
# ATURI_DB_SERVICE_KEY=
# ATURI_DB_SCHEMA=aturi

# On Supabase you must also add the schema under Settings -> API -> Exposed
# schemas, or PostgREST cannot see any table and every query 404s.

# 32 bytes, hex or base64: `openssl rand -hex 32`. Encrypts OAuth tokens at
# rest. Keep it somewhere other than the database credential, or it protects
# nothing.
# ATURI_SESSION_ENC_KEY=

# Exact return targets for extension sign-in, comma-separated. Never a
# wildcard.
# ATURI_EXTENSION_RETURN_ORIGINS=https://<extension-id>.chromiumapp.org/

# Session lifetime in days (default 30), refreshed on use.
# ATURI_APP_SESSION_TTL_DAYS=30

# Which client a NEW sign-in uses: auto (default) | bff | browser.
# "auto" uses the backend when one is configured, and always honours an
# existing browser session, so nobody signed in today is logged out.
# Rollback is setting this to "browser".
# NEXT_PUBLIC_AUTH_MODE=auto

# Where the backend lives, for BEARER callers only — the extension, and local
# development pointed at a deployed backend. The web app cannot use this: its
# session is an HttpOnly cookie on the backend's own origin, so a cross-origin
# backend would sign in and then report the user as signed out. Leave unset.
# NEXT_PUBLIC_BFF_ORIGIN=
