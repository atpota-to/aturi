{
  "name": "aturi-agent",
  "description": "A Bluesky account that answers @mentions about the Atmosphere, via the aturi.to MCP server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node --experimental-transform-types src/index.ts",
    "tick": "node --experimental-transform-types src/index.ts --once",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.67",
    "@ai-sdk/mcp": "^2.0.39",
    "@atproto/api": "^0.20.5",
    "ai": "^7.0.83"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
