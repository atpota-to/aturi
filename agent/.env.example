# The three required secrets.
#
# BLUESKY_APP_PASSWORD is an app password from the bot account's own settings
# (Settings -> Privacy and security -> App passwords), never the account
# password. Revoking it revokes only this agent.
BLUESKY_IDENTIFIER=your-bot.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# A Vercel AI Gateway key. The agent talks to the gateway rather than to one
# vendor so the model below can be swapped without a code change.
AI_GATEWAY_API_KEY=vck_...

# Any model the gateway routes to, as provider/model. This is the knob to
# turn when comparing models; nothing else in the agent is provider-specific.
# AGENT_MODEL=anthropic/claude-opus-5

# The Atmosphere MCP server. Keyless and read-only.
# MCP_URL=https://aturi.to/api/mcp

# Jetstream. Both dialects are understood, so this can point at whichever
# instance you already run:
#   v2  wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
#   v1  wss://jetstream2.us-east.bsky.network/subscribe
# JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents

# Where the stream position is persisted, so a restart resumes instead of
# skipping to the live edge. Needs to survive a redeploy to be worth anything.
# CURSOR_FILE=.jetstream-cursor

# The backstop sweep over the notification API, in minutes. Jetstream is
# at-least-once, not never-miss.
# RECONCILE_MINUTES=10

# The sweep ignores mentions older than this, so an outage does not produce a
# burst of late answers when the agent comes back.
# LOOKBACK_MINUTES=120

# Posts per answer, above which the agent chains a self-reply thread.
# MAX_POSTS_PER_REPLY=3

# Abuse and cost caps. The per-account one is what stops a single person
# turning the account into their own toy; the global one bounds the bill.
# MAX_REPLIES_PER_AUTHOR_PER_HOUR=6
# MAX_REPLIES_PER_HOUR=60

# Model steps per answer, which bounds tool calls per mention.
# MAX_STEPS=8

# Comma-separated handles or DIDs. While ALLOWLIST is set the agent answers
# only those accounts, which is how to test in public. Empty means everyone.
# BLOCKLIST always wins.
# ALLOWLIST=you.bsky.social
# BLOCKLIST=

# Compose answers and print them without posting.
# DRY_RUN=true
