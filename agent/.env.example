# The three required secrets.
#
# BLUESKY_APP_PASSWORD is an app password from the bot account's own settings
# (Settings -> Privacy and security -> App passwords), never the account
# password. Revoking it revokes only this agent.
BLUESKY_IDENTIFIER=your-bot.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ANTHROPIC_API_KEY=sk-ant-...

# The PDS the bot account lives on.
# BLUESKY_SERVICE=https://bsky.social

# The Atmosphere MCP server. Keyless and read-only.
# MCP_URL=https://aturi.to/api/mcp

# AGENT_MODEL=claude-opus-5

# Answer at most this many mentions per pass, and spend at most this many
# posts on one answer. Both are cost and blast-radius controls; raise them
# only once you have watched the account behave.
# MAX_REPLIES_PER_TICK=5
# MAX_POSTS_PER_REPLY=3

# Ignore mentions older than this, so an outage does not produce a burst of
# late answers when the agent comes back.
# LOOKBACK_MINUTES=120

# Seconds between passes when running as a long-lived process.
# POLL_INTERVAL_SECONDS=60

# Comma-separated handles or DIDs. While this is set the agent answers only
# these accounts, which is how to test in public. Empty means answer everyone.
# ALLOWLIST=you.bsky.social

# Compose answers and print them without posting.
# DRY_RUN=true
