# Copy to /etc/aturi-agent.env, fill in, then lock it down:
#
#   sudo install -o root -g aturi -m 0640 aturi-agent.env.example /etc/aturi-agent.env
#   sudo -e /etc/aturi-agent.env
#
# systemd's EnvironmentFile is not a shell script: no `export`, no quotes
# unless the value really contains them, no variable interpolation.

BLUESKY_IDENTIFIER=your-bot.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
AI_GATEWAY_API_KEY=vck_xxx

# Must sit inside the StateDirectory systemd creates — the rest of the
# filesystem is read-only to this service.
CURSOR_FILE=/var/lib/aturi-agent/jetstream-cursor

# Uncomment for the first run in production, then remove once the replies
# read the way you want.
# ALLOWLIST=you.bsky.social
