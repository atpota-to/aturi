{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "altsky.app"
        }
      ],
      "destination": "https://aturi.to/:path*",
      "permanent": true
    }
  ],
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/oauth/**/route.ts": {
      "maxDuration": 30
    }
  }
}
